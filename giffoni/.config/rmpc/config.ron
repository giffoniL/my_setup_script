#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    // --------------------------------------------------
    // Connection
    // --------------------------------------------------
    address: "127.0.0.1:6600",
    password: None,

    // --------------------------------------------------
    // General
    // --------------------------------------------------
    theme: Some("theme"),
    volume_step: 10,
    max_fps: 60,
    scrolloff: 4,
    select_current_song_on_change: true,
    center_current_song_on_change: true,

    // --------------------------------------------------
    // Sorting
    // --------------------------------------------------
    browser_song_sort: [
        Disc,
        Track,
        Artist,
        Title,
    ],

    directories_sort: SortFormat(
        group_by_type: true,
        reverse: false,
    ),

    // --------------------------------------------------
    // Keybinds
    // --------------------------------------------------
    keybinds: (
    	clear: true,
        global: {
            "q":          Quit,
            "?":          ShowHelp,
            ":":          CommandMode,
            "I":         ShowCurrentSongInfo,
            "z":          ToggleRepeat,
            "x":          ToggleRandom,
            "c":          ToggleConsume,
            "v":          ToggleSingle,
            "p":          TogglePause,
            ">":          NextTrack,
            "<":          PreviousTrack,
            ".":          VolumeUp,
            ",":          VolumeDown,
            "<Tab>":      NextTab,
            "<S-Tab>":    PreviousTab,
            "1":          SwitchToTab("Queue"),
            "2":          SwitchToTab("Directories"),
            "3":          SwitchToTab("Artists"),
            "4":          SwitchToTab("Album Artists"),
            "5":          SwitchToTab("Albums"),
            "6":          SwitchToTab("Playlists"),
            "7":          SwitchToTab("Search"),
            "<C-u>":      Update,
            "<C-U>":      Rescan,
        },
        navigation: {
            "<Esc>":      Close,
            "<CR>":       Confirm,
            "<Up>":       Up,
            "<Down>":     Down,
            "<Left>":     Left,
            "<Right>":    Right,
            "<C-Up>":     PaneUp,
            "<C-Down>":   PaneDown,
            "<C-Left>":   PaneLeft,
            "<C-Right>":  PaneRight,
            "<PageUp>":   PageUp,
            "<PageDown>": PageDown,
            "<Space>":    Select,
            "<C-Space>":  InvertSelection,
            "<C-f>":          EnterSearch,
            "n":          NextResult,
            "N":          PreviousResult,
            "a":          Add,
            "A":          AddAll,
            "D":          Delete,
            "i":          FocusInput,
        },
        queue: {
            "d":          Delete,
            "D":          DeleteAll,
            "<CR>":       Play,
            "o":          JumpToCurrent,
            "X":          Shuffle,
        },
    ),

    // --------------------------------------------------
    // CAVA
    // --------------------------------------------------
    cava: (
        lower_cutoff_freq: 50,
        higher_cutoff_freq: 10000,

        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",

            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),

        smoothing: (
        ),

        eq: [],
    ),

    // --------------------------------------------------
    // Album Art
    // --------------------------------------------------
    album_art: (
        method: Auto,

        max_size_px: (
            width: 1200,
            height: 1200,
        ),

        disabled_protocols: [
            "http://",
            "https://",
        ],

        vertical_align: Center,
        horizontal_align: Center,
    ),

    // --------------------------------------------------
    // Search
    // --------------------------------------------------
    search: (
        case_sensitive: false,
        ignore_diacritics: false,
        search_button: false,

        mode: Contains,

        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
            (value: "filename",    label: "Filename"),
            (value: "genre",       label: "Genre"),
        ],
    ),

    // --------------------------------------------------
    // Artists
    // --------------------------------------------------
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
        album_date_tags: [Date],
    ),

    // --------------------------------------------------
    // Tabs
    // --------------------------------------------------
    tabs: [
        // ==============================================
        // Home
        // ==============================================
        (
            name: "Home",

            pane: Split(
                direction: Vertical,

                panes: [
                    (
                        size: "60%",

                        pane: Split(
                            direction: Horizontal,

                            panes: [
                                // Album Art
                                (
                                    size: "30%",
                                    borders: "ALL",
                                    border_symbols: Thick,

                                    pane: Pane(AlbumArt),
                                ),

                                // Queue Section
                                (
                                    size: "70%",

                                    pane: Split(
                                        direction: Vertical,

                                        panes: [
                                            // Queue Header
                                            (
                                                size: "3",

                                                borders: "ALL",

                                                border_symbols: Inherited(
                                                    parent: Thick,
                                                    bottom_left: "┃",
                                                    bottom_right: "┃",
                                                ),

                                                pane: Split(
                                                    direction: Horizontal,

                                                    panes: [
                                                        (
                                                            size: "1",
                                                            pane: Pane(Empty()),
                                                        ),

                                                        (
                                                            size: "100%",
                                                            pane: Pane(QueueHeader()),
                                                        ),
                                                    ],
                                                ),
                                            ),

                                            // Queue
                                            (
                                                size: "100%",

                                                borders: "LEFT | RIGHT | BOTTOM",
                                                border_symbols: Thick,

                                                pane: Split(
                                                    direction: Horizontal,

                                                    panes: [
                                                        (
                                                            size: "1",
                                                            pane: Pane(Empty()),
                                                        ),

                                                        (
                                                            size: "100%",
                                                            pane: Pane(Queue),
                                                        ),
                                                    ],
                                                ),
                                            ),
                                        ],
                                    ),
                                ),
                            ],
                        ),
                    ),

                    // CAVA Visualizer
                    (
                        size: "40%",
                        borders: "ALL",
                        border_symbols: Thick,

                        pane: Pane(Cava),
                    ),
                ],
            ),
        ),

        // ==============================================
        // Directories
        // ==============================================
        (
            name: "Directories",

            borders: "ALL",
            border_symbols: Thick,

            pane: Split(
                size: "100%",
                direction: Vertical,

                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Thick,

                        pane: Pane(Directories),
                    ),
                ],
            ),
        ),

        // ==============================================
        // Search
        // ==============================================
        (
            name: "Search",

            borders: "ALL",
            border_symbols: Thick,

            pane: Split(
                size: "100%",
                direction: Vertical,

                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Thick,

                        pane: Pane(Search),
                    ),
                ],
            ),
        ),
    ],
)
