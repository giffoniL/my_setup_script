{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
	  "type": "file",
	  "source": "~/.config/fastfetch/logo.txt",
  "color": {
    "1": "black",
    "2": "red",
    "3": "white",
    "4": "yellow"
  },
	  "position": "top",
	  "padding": {
	  }
	},
  "modules": [
    {
      "type": "title",
      "key": "┏━ ",
      "format": "{user-name}@{host-name}",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "host",
      "key": "┣━ 󰌢",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "kernel",
      "key": "┣━ ",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "os",
      "key": "┣━ {icon}",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "cpu",
      "key": "┣━ 󰻠",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "gpu",
      "key": "┣━ 󰍛",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "disk",
      "key": "┣━ ",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "memory",
      "key": "┣━ 󰑭",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "battery",
      "key": "┣━ ",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "poweradapter",
      "key": "┣━ ",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "packages",
      "key": "┣━ 󰏖",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "shell",
      "key": "┣━ ",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "wm",
      "key": "┣━ ",
      "keyColor": "white",
      "outputColor": "white",
    },
    {
      "type": "uptime",
      "key": "┗━ 󰅐",
      "keyColor": "white",
      "outputColor": "white",
    },
    "break",
    "colors",
  ],
}


